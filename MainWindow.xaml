<Window x:Class="GridDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GridDemo"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width=" 20"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width=" 20"/>
        </Grid.ColumnDefinitions>
        
        <Grid.RowDefinitions>
            <RowDefinition Height=" 20"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height=" 20"/>
        </Grid.RowDefinitions>
        
        <!--Titel-->
        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="Welcome to Tinder" FontSize="36" FontWeight="Bold" Background="LightPink"/>
        <Rectangle Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6" Fill="LightPink" Panel.ZIndex="-1"/>
        
        <!--First name-->
        <TextBox Name="FirstNameText" Grid.Row="2" Grid.Column="2" Width="150"/>
        <TextBlock Grid.Row="2" Grid.Column="1" FontWeight="Bold" Text="First name" FontSize="20" />

        <!--First name-->
        <TextBox Name="LastNameText" Grid.Row="3" Grid.Column="2" Width="150"/>
        <TextBlock Grid.Row="3" Grid.Column="1" FontWeight="Bold" Text="Last name" FontSize="20" />

        <!--Submit-->
        <Button Name="SubmitButton" Grid.Column="1" Grid.Row="4" Content="Submit" Grid.ColumnSpan="2" Click="SubmitBtnClick"/>

        <!--Menu console-->
        <Menu Grid.ColumnSpan="3" FontSize="16">
            <MenuItem Header="File">
                <MenuItem Header="Exit"/>
            </MenuItem>
            <MenuItem Header="Edit">
                <MenuItem Header="Refactor"/>
            </MenuItem>
        </Menu>

    </Grid>
</Window>
